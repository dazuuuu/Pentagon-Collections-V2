# Copy this file to .env in this same folder (apps/apps_collections/).
# Never commit .env.
#
# Shared hosting layout:
#   public_html/                 <- upload the contents of /public
#   apps/apps_collections/       <- this folder (vendor, app, .env, database)
# Other apps on the same account go in sibling folders under apps/.


APP_URL=http://localhost/Pentagon-Collections-V2/public
APP_NAME="Al NAHDA Agency"
APP_DEBUG=1

# --- Database (AMPPS MySQL default: root / no password) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=alnahda_db
DB_USER=root
DB_PASS=mysql

# --- SMTP (used for portal login codes & applicant notifications) ---
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=you@example.com
MAIL_PASSWORD=changeme
MAIL_FROM_ADDRESS=Alnahdaagency@gmail.com
MAIL_FROM_NAME="Al NAHDA Agency"

# --- Admin seed account (only used the first time the DB is set up) ---
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=change-this-password
